{
  "name": "mugen-js",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "M.U.G.E.N 1.1 rebuilt for the browser, in TypeScript and WebGL2",
  "license": "MIT",
  "author": "Jonathan Ayala",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yojona/mugen-js.git"
  },
  "homepage": "https://github.com/yojona/mugen-js",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mugen.min.js": "./dist/mugen.min.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.ts && vite build --config vite.lib.config.ts --mode min && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "build:example": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "prettier --check \"{src,examples,tests,tools}/**/*.ts\" \"*.config.ts\" && tsc --noEmit && vitest run",
    "format": "prettier --write \"{src,examples,tests,tools}/**/*.ts\" \"*.config.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
